# ============================================
# Public (exposed to the browser)
# ============================================
NEXT_PUBLIC_APP_NAME=Sunny WhatsUp
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Meta Embedded Signup
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
NEXT_PUBLIC_META_CONFIG_ID=your-embedded-signup-config-id
NEXT_PUBLIC_META_GRAPH_VERSION=v21.0

# Sentry (error monitoring). Set these in the Vercel project settings, not here.
# Leave NEXT_PUBLIC_SENTRY_DSN empty to keep Sentry switched off (default for local dev).
NEXT_PUBLIC_SENTRY_DSN=
# Optional: on Vercel the environment is read from NEXT_PUBLIC_VERCEL_ENV, so set
# this only to override it (e.g. to "development" when testing against a local DSN).
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Sampling. All default to 1 (capture everything) when unset; set a fraction
# such as 0.1 to sample 10% once traffic grows. Replays are the priciest.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=1
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1
